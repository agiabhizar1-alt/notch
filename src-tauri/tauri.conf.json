{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notch",
  "version": "1.0.0",
  "identifier": "id.notch.desktopwidget",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Notch Desktop Widget",
        "width": 480,
        "height": 650,
        "minWidth": 260,
        "minHeight": 54,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true,
        "shadow": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "Pengaturan Notch",
        "url": "settings.html",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 620,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
